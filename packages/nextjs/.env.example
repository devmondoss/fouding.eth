# Copia este archivo a .env.local y completa los valores.
# Nada de esto lleva el prefijo NEXT_PUBLIC_ salvo lo que el navegador
# necesita leer directamente (ver lib/protocolServer.ts y Web3Provider.tsx).

## Privy — login y wallet embebida (obligatorio para arrancar la app)
# Sacalo en https://dashboard.privy.io (app nueva, "Email" como login method)
NEXT_PUBLIC_PRIVY_APP_ID=
# Solo lo usa app/api/account/delete — no bloquea el arranque si falta
PRIVY_APP_SECRET=

## Base de datos (Neon/Postgres) — cae al seed si no responde, pero sin
## esto no hay catálogo real ni expedientes
DATABASE_URL=

## Chain del protocolo: "412346" (devnet local) o "421614" (Arbitrum Sepolia)
NEXT_PUBLIC_PROTOCOL_CHAIN_ID=412346
PROTOCOL_CHAIN_ID=412346
NEXT_PUBLIC_NITRO_RPC_URL=http://127.0.0.1:8547
NITRO_RPC_URL=http://127.0.0.1:8547
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

## Claves de operación del servidor — nunca las de un usuario real. En
## devnet son las cuentas determinísticas de Nitro (ver README).
PASSPORT_OPERATOR_PRIVATE_KEY=
COMPLIANCE_OPERATOR_PRIVATE_KEY=
SERVICER_OPERATOR_PRIVATE_KEY=
PASSPORT_TTL_DAYS=365
PASSPORT_DEFAULT_RISK_TIER=2

## Panel del verificador
VERIFIER_API_KEY=

## Opcional — scaffold-eth (no lo usa el protocolo)
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
