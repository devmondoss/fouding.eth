{
  "name": "@founding/nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "check-types": "tsc --noEmit --incremental",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "indexer": "tsx --env-file-if-exists=.env.local scripts/indexer.ts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "faucet:check": "tsx --env-file-if-exists=.env.local scripts/faucet-status.ts",
    "seed:catalogo": "tsx --env-file-if-exists=.env.local scripts/seed-catalog.ts",
    "check:scroll": "node scripts/check-scroll-lock.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:ux": "node scripts/check-scroll-lock.mjs && node scripts/check-routes.mjs"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@neondatabase/serverless": "^1.1.0",
    "@privy-io/react-auth": "^3.36.1",
    "@privy-io/server-auth": "^1.32.5",
    "@privy-io/wagmi": "^4.0.15",
    "@stripe/stripe-js": "^9.13.0",
    "@tanstack/react-query": "^5.101.4",
    "accounts": "~0.14.0",
    "lucide-react": "^1.28.0",
    "mona-sans": "^1.0.0",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
    "usehooks-ts": "^3.1.0",
    "viem": "2.55.5",
    "wagmi": "3.7.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "abitype": "1.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "type-fest": "^4.26.1",
    "typescript": "^5"
  }
}
