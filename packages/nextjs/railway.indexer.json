{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && corepack yarn install --immutable"
  },
  "deploy": {
    "startCommand": "corepack yarn workspace @founding/nextjs indexer",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
